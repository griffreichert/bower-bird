# Copy to .env and fill in. .env is gitignored.

# Telegram bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=

# Anthropic API key — first-party API (required). The SDK reads this directly.
ANTHROPIC_API_KEY=

# --- Optional overrides ---

# bower-bird's owned folder inside the Obsidian vault — the only place it
# writes. Auto-resolves from the notes/ symlink if unset.
# BOWER_VAULT_PATH=

# Models are declared in-package (config.py: pull=Haiku, build=Sonnet), not here
# — the two-model pipeline is design, not deployment config.

# Runtime state file (telegram offset + url dedup). Defaults to data/state.json.
# BOWER_STATE_PATH=

# Per-fetch / per-API timeout in seconds. Default 15.
# BOWER_FETCH_TIMEOUT=15

# Max updates pulled per pass. Default 100.
# BOWER_QUEUE_LIMIT=100
